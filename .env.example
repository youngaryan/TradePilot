APP_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development keeps demo accounts enabled. Set false in production.
ENABLE_DEMO_ACCOUNTS=true
ENABLE_IN_PROCESS_JOBS=true
ALLOW_TRIAL_ENTITLEMENTS=false

DATABASE_URL=postgresql+psycopg://quantops:quantops@postgres:5432/quantops
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-with-32-byte-random-secret
CSRF_SECRET=replace-with-32-byte-random-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_SUCCESS_URL=http://localhost:5173/app/pricing?billing=success
STRIPE_CANCEL_URL=http://localhost:5173/pricing?billing=cancelled

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=quantops-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@quantops.local

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
RUN_DB_MIGRATIONS=true
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=180

PAIRS_TRADING_METADATA_DB_PATH=artifacts/metadata/app.sqlite3
PAIRS_TRADING_PAPER_STATE_DIR=artifacts/paper/state
PAIRS_TRADING_PAPER_ARTIFACT_ROOT=artifacts/paper/runs
PAIRS_TRADING_PAPER_JOB_STATE_DIR=artifacts/paper/jobs
PAIRS_TRADING_BACKTEST_ARTIFACT_ROOT=artifacts/backtests/experiments
PAIRS_TRADING_BACKTEST_JOB_STATE_DIR=artifacts/backtests/jobs
PAIRS_TRADING_MARKET_RESEARCH_ARTIFACT_ROOT=artifacts/market_research/reports
PAIRS_TRADING_MARKET_RESEARCH_JOB_STATE_DIR=artifacts/market_research/jobs
PAIRS_TRADING_MARKET_RESEARCH_DATA_PROVIDER=demo
PAIRS_TRADING_MARKET_RESEARCH_AGENT_TIMEOUT_SECONDS=8.0
PAIRS_TRADING_SECRET_BACKEND=env
PAIRS_TRADING_MARKET_RESEARCH_LLM_PROVIDER=mock
PAIRS_TRADING_MARKET_RESEARCH_LLM_MODEL=mock-research-v1
PAIRS_TRADING_MARKET_RESEARCH_LLM_TIMEOUT_SECONDS=30
PAIRS_TRADING_MARKET_RESEARCH_LLM_MAX_RETRIES=1
PAIRS_TRADING_MARKET_RESEARCH_LLM_MAX_CONCURRENCY=2
PAIRS_TRADING_MARKET_RESEARCH_OPENAI_API_KEY_REF=env:OPENAI_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_ANTHROPIC_API_KEY_REF=env:ANTHROPIC_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PAIRS_TRADING_SENTIMENT_CACHE_DIR=data/sentiment_cache
PAIRS_TRADING_SENTIMENT_JOB_STATE_DIR=artifacts/sentiment/jobs
