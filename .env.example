APP_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Local development keeps demo accounts enabled. Set false in production.
ENABLE_DEMO_ACCOUNTS=true
ENABLE_IN_PROCESS_JOBS=true
ALLOW_TRIAL_ENTITLEMENTS=false
JOB_LEASE_SECONDS=180
JOB_HEARTBEAT_SECONDS=30
JOB_RECOVERY_POLL_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_RECOVERY_BATCH_SIZE=100

# Configure each sensitive value directly OR through its matching *_FILE,
# never both. Production should use mounted secret files.
DATABASE_URL=
DATABASE_URL_FILE=
REDIS_URL=
REDIS_URL_FILE=
SESSION_SECRET=
SESSION_SECRET_FILE=
CSRF_SECRET=
CSRF_SECRET_FILE=
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_FILE=
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_FILE=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_FILE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_SUCCESS_URL=http://localhost:5173/app/pricing?billing=success
STRIPE_CANCEL_URL=http://localhost:5173/pricing?billing=cancelled

S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY=
S3_SECRET_ACCESS_KEY_FILE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USERNAME_FILE=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@quantops.local

SENTRY_DSN=
SENTRY_DSN_FILE=
SENTRY_DSN_SECRET_FILE=
SENTRY_REQUIRED=false
SENTRY_TRACES_SAMPLE_RATE=0.05
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=dev
LOG_LEVEL=INFO
LOG_JSON=false
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_METRICS_TOKEN=
OBSERVABILITY_METRICS_TOKEN_FILE=
OBSERVABILITY_METRICS_PORT=0
RUN_DB_MIGRATIONS=false
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=180

PAIRS_TRADING_METADATA_DB_PATH=artifacts/metadata/app.sqlite3
PAIRS_TRADING_PAPER_STATE_DIR=artifacts/paper/state
PAIRS_TRADING_PAPER_ARTIFACT_ROOT=artifacts/paper/runs
PAIRS_TRADING_PAPER_JOB_STATE_DIR=artifacts/paper/jobs
PAIRS_TRADING_BACKTEST_ARTIFACT_ROOT=artifacts/backtests/experiments
PAIRS_TRADING_BACKTEST_JOB_STATE_DIR=artifacts/backtests/jobs
PAIRS_TRADING_MARKET_RESEARCH_ARTIFACT_ROOT=artifacts/market_research/reports
PAIRS_TRADING_MARKET_RESEARCH_JOB_STATE_DIR=artifacts/market_research/jobs
PAIRS_TRADING_MARKET_RESEARCH_DATA_PROVIDER=demo
# Development-only safety valve. Production startup requires cached_yahoo and false.
PAIRS_TRADING_MARKET_RESEARCH_ALLOW_DEMO_FALLBACK=true
SEC_EDGAR_USER_AGENT=
PAIRS_TRADING_MARKET_RESEARCH_AGENT_TIMEOUT_SECONDS=120.0
PAIRS_TRADING_SECRET_BACKEND=env
PAIRS_TRADING_STRATEGY_BUILDER_MODE=rules
# Supported providers: openai, anthropic, deepinfra, nvidia, ollama. Set a model id valid
# for the selected provider; see docs/strategy_builder_providers.md.
PAIRS_TRADING_STRATEGY_BUILDER_LLM_PROVIDER=openai
PAIRS_TRADING_STRATEGY_BUILDER_LLM_MODEL=gpt-5-mini
PAIRS_TRADING_STRATEGY_BUILDER_LLM_TIMEOUT_SECONDS=30
PAIRS_TRADING_STRATEGY_BUILDER_LLM_MAX_RETRIES=1
PAIRS_TRADING_STRATEGY_BUILDER_LLM_MAX_CONCURRENCY=2
PAIRS_TRADING_STRATEGY_BUILDER_OPENAI_API_KEY_REF=env:OPENAI_API_KEY
PAIRS_TRADING_STRATEGY_BUILDER_ANTHROPIC_API_KEY_REF=env:ANTHROPIC_API_KEY
PAIRS_TRADING_STRATEGY_BUILDER_DEEPINFRA_API_KEY_REF=env:DEEPINFRA_API_KEY
PAIRS_TRADING_STRATEGY_BUILDER_DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
PAIRS_TRADING_STRATEGY_BUILDER_NVIDIA_API_KEY_REF=env:NVIDIA_API_KEY
PAIRS_TRADING_STRATEGY_BUILDER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PAIRS_TRADING_STRATEGY_BUILDER_OLLAMA_BASE_URL=http://127.0.0.1:11434
PAIRS_TRADING_MARKET_RESEARCH_LLM_PROVIDER=mock
PAIRS_TRADING_MARKET_RESEARCH_LLM_MODEL=mock-research-v1
PAIRS_TRADING_MARKET_RESEARCH_LLM_TIMEOUT_SECONDS=120
PAIRS_TRADING_MARKET_RESEARCH_LLM_MAX_RETRIES=1
PAIRS_TRADING_MARKET_RESEARCH_LLM_MAX_CONCURRENCY=1
PAIRS_TRADING_MARKET_RESEARCH_FREE_ENDPOINT_TIMEOUT_CAP_SECONDS=160
PAIRS_TRADING_MARKET_RESEARCH_LLM_FAIL_FAST_AFTER_FAILURES=1
PAIRS_TRADING_MARKET_RESEARCH_ALLOW_REQUEST_MODEL_OVERRIDE=true
PAIRS_TRADING_MARKET_RESEARCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
PAIRS_TRADING_MARKET_RESEARCH_OPENAI_API_KEY_REF=env:OPENAI_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_ANTHROPIC_API_KEY_REF=env:ANTHROPIC_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_NVIDIA_API_KEY_REF=env:NVIDIA_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PAIRS_TRADING_MARKET_RESEARCH_NEWS_PROVIDERS=
PAIRS_TRADING_MARKET_RESEARCH_NEWSAPI_API_KEY_REF=env:NEWSAPI_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_ALPHAVANTAGE_API_KEY_REF=env:ALPHAVANTAGE_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_BENZINGA_API_KEY_REF=env:BENZINGA_API_KEY
PAIRS_TRADING_MARKET_RESEARCH_NEWS_MAX_ARTICLES=100
PAIRS_TRADING_MARKET_RESEARCH_NEWS_LOOKBACK_DAYS=30
PAIRS_TRADING_MARKET_RESEARCH_PROVIDER_TIMEOUT_SECONDS=20
PAIRS_TRADING_MARKET_RESEARCH_NEWS_REQUIRED=false
PAIRS_TRADING_MARKET_RESEARCH_FUNDAMENTALS_REQUIRED=false
PAIRS_TRADING_MARKETPLACE_ENABLED=false
# Must remain false until the separate legal/product policy gate is approved.
PAIRS_TRADING_MARKETPLACE_CREATOR_CREDITS_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
NVIDIA_API_KEY=
NVIDIA_API_KEY_FILE=
PAIRS_TRADING_SENTIMENT_CACHE_DIR=data/sentiment_cache
PAIRS_TRADING_SENTIMENT_JOB_STATE_DIR=artifacts/sentiment/jobs
