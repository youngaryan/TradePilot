ARG PYTHON_IMAGE=python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
FROM ${PYTHON_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY requirements/backend-py312.lock ./requirements/backend-py312.lock
COPY pyproject.toml README.md ./
COPY pairs_trading ./pairs_trading
COPY apps ./apps

RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --require-hashes -r requirements/backend-py312.lock \
    && /opt/venv/bin/python -m pip wheel --no-deps --no-build-isolation --wheel-dir /build/dist . \
    && /opt/venv/bin/python -m pip install --no-deps /build/dist/quant_research_app-*.whl \
    && /opt/venv/bin/python -m pip check

FROM ${PYTHON_IMAGE} AS runtime

ARG APP_UID=10001
ARG APP_GID=10001

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp/tradepilot \
    XDG_CACHE_HOME=/tmp/tradepilot/cache \
    MPLCONFIGDIR=/tmp/tradepilot/matplotlib

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=${APP_UID}:${APP_GID} examples ./examples
COPY --chown=${APP_UID}:${APP_GID} migrations ./migrations
COPY --chown=${APP_UID}:${APP_GID} alembic.ini ./
COPY --chown=${APP_UID}:${APP_GID} scripts ./scripts

RUN groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/artifacts /app/data /tmp/tradepilot \
    && chown -R "${APP_UID}:${APP_GID}" /app /tmp/tradepilot \
    && chmod 0755 /app/scripts/docker-entrypoint.sh /app/scripts/run-migrations.sh

USER ${APP_UID}:${APP_GID}

EXPOSE 8000

CMD ["/app/scripts/docker-entrypoint.sh"]
